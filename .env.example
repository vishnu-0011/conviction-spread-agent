# Never commit real credentials. Use keys from a development paper account here.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Safe defaults: the executor remains disabled until both are deliberately changed.
CSA_EXECUTION_ENABLED=false
CSA_DRY_RUN=true
CSA_KILL_SWITCH=false

# All trading decisions are evaluated in US/Eastern market time.
CSA_TIMEZONE=America/New_York
CSA_UNIVERSE=SPY,QQQ,IWM,AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA
